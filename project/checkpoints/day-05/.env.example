# .env.example - documents every environment variable the project reads.
# This file is committed. It contains PLACEHOLDERS ONLY - never real values.
# Real values live in your shell / on Render, never in Git.

# Long random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-value

# "True" for local development, "False" in production
DEBUG=False

# Comma-separated host names that may serve the app
ALLOWED_HOSTS=your-app-name.onrender.com

