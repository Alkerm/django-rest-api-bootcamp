{
  "info": {
    "name": "Task Management API",
    "description": "Tuwaiq Club at KFUPM - Building REST APIs with Django. Requires the environment variables base_url, username, password and token. Placeholders only: never store real secrets here.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/token/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "token",
            ""
          ]
        },
        "description": "Exchange username/password for a token and store it in {{token}}.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.environment.set('token', data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "List tasks",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/tasks/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "tasks",
            ""
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/tasks/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "tasks",
            ""
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Prepare demo\",\n  \"description\": \"Day 5 live demo\",\n  \"status\": \"TODO\",\n  \"due_date\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.environment.set('task_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
