# .env.example - documents the environment variables this project reads.
# Committed to Git with PLACEHOLDERS ONLY. Real values are set in the terminal or on the hosting platform.

# Long random string used for signing. Placeholder only.
SECRET_KEY=replace-with-a-long-random-value

# True for local development, False in production
DEBUG=False

# Comma-separated host names, e.g. 127.0.0.1,localhost or my-app.onrender.com
ALLOWED_HOSTS=my-app.onrender.com
